# === Secrets: never commit these ===================================
# The integration itself needs NO secret files. These are only ever
# produced locally by scripts/probe_api.py or by your editor.
.inetrack_key
*.key
*.pem
*.p12
*.pfx
secrets.*
.env
.env.*
credentials*.json
# scripts/probe_api.py output: contains live account data (positions, IDs)
probe-output.json
probe-output*.json

